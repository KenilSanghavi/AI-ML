import numpy as np
while True:
    print("welcome to numpy analyzer")
    print("=========================")
    print("1.create numpy array")
    print("2.perform mathematical operarion")
    print("3.combine or split array")
    print("4.search,sort or filter arrays")
    print("5.compute aggregates andd statistics")
    print("6.exit")

    choice=int(input("enter your choice"))
    if choice==1:
        print("select the type of array")
        print("1.1D array")
        print("2.2D array")
        print("3.3D array")
        arr_select=int(input("enter your choice"))
        if arr_select==1:
            size=int(input("enter size of array"))
            elements=list(map(int,input(f"enter {size} elements by space").split()))
            arr=np.array(elements)
            print("array created!!")
            print(arr)

        if arr_select==2:
            rows=int(input("enter number of rows"))
            column=int(input("enter number of columns"))
            elements=list(map(int,input(f"enter {rows*column} elements by space").split()))
            arr=np.array(elements).reshape(rows,column)
            print("array created!!")
            print(arr)            

        if arr_select==3:
            block = int(input("\nEnter number of blocks: "))
            rows_3d = int(input("Enter number of rows: "))
            column_3d = int(input("Enter number of columns: "))
            elements = list(map(int,input(f"Enter {block*rows_3d*column_3d} elements separated by space: ").split()))
            arr= np.array(elements).reshape(block,rows_3d,column_3d)
            print("array created!!")
            print(arr) 

        while True:
        
            print("\nChoose an operation:")
            print("1. Indexing")
            print("2. Slicing")
            print("3. Go Back")

            input1=int(input("enter your choice"))
            if input1==1:
                if arr.ndim == 1:
                    index= int(input("Enter index: "))
                    print("Element:", arr[index])

                elif arr.ndim == 2:
                    row = int(input("Enter row index: "))
                    col = int(input("Enter column index: "))
                    print("Element:", arr[row, col])

                elif arr.ndim == 3:
                    x = int(input("Enter block index: "))
                    y = int(input("Enter row index: "))
                    z = int(input("Enter column index: "))
                    print("Element:", arr[x, y, z])

            elif input1 == 2:

                if arr.ndim == 1:
                    start, end = map(int, input("Enter range (start:end): ").split(":"))
                    print("\nSliced Array:")
                    print(arr[start:end])

                elif arr.ndim == 2:
                    row_start, row_end = map(int,input("Enter the row range (start:end): ").split(":"))

                    col_start, col_end = map(int,input("Enter the column range (start:end): ").split(":"))

                    print("\nSliced Array:")
                    print(arr[row_start:row_end, col_start:col_end])

                elif arr.ndim == 3:
                    x_start, x_end = map(int,input("Enter block range (start:end): ").split(":"))

                    y_start, y_end = map(int,input("Enter row range (start:end): ").split(":"))

                    z_start, z_end = map(int,input("Enter column range (start:end): ").split(":"))

                    print("\nSliced Array:")
                    print(arr[x_start:x_end, y_start:y_end, z_start:z_end])

            elif input1 == 3:
                print("Going Back...")
                break

            else:
                print("Invalid choice!")
    if choice==2:
        print("\nMathematical Operations:")
        print("Choose a mathematical operation:")
        print("1. Addition")
        print("2. Subtraction")
        print("3. Multiplication")
        print("4. Division")

        math_choice = int(input("Enter your choice: "))
        elements = list(map(int,input(f"\nEnter the same-size array elements ({arr.size} elements separated by space): ").split()))
        arr2 = np.array(elements).reshape(arr.shape)
        if math_choice == 1:
            result = arr + arr2
            operation = "Addition"

        elif math_choice == 2:
            result = arr - arr2
            operation = "Subtraction"

        elif math_choice == 3:
            result = arr * arr2
            operation = "Multiplication"

        elif math_choice == 4:
            result = arr / arr2
            operation = "Division"

        else:
            print("Invalid choice!")
        if math_choice in [1, 2, 3, 4]:
            print("\nOriginal Array:")
            print(arr)

            print("\nSecond Array:")
            print(arr2)

            print(f"\nResult of {operation}:")
            print(result)
    if choice==3:
        print("\nCombine or Split Arrays:")
        print("Choose an option:")
        print("1. Combine Arrays")
        print("2. Split Array")

        combine_choice = int(input("Enter your choice: "))
        if combine_choice == 1:

            elements = list(map(int,input(f"\nEnter the elements of another array to combine ({arr.size} elements separated by space): ").split()))

            arr2 = np.array(elements).reshape(arr.shape)

            print("\nOriginal Array:")
            print(arr)

            print("\nSecond Array:")
            print(arr2)
            combined = np.vstack((arr, arr2))

            print("\nCombined Array (Vertical Stack):")
            print(combined)
        elif combine_choice == 2:

            print("\nOriginal Array:")
            print(arr)

            split_arrays = np.vsplit(arr, 2)

            print("\nSplit Arrays:")

            for i, part in enumerate(split_arrays):
                print(f"\nPart {i+1}:")
                print(part)

        else:
            print("Invalid choice!")
    if choice==4: 
        print("\nSearch, Sort, and Filter:")
        print("Choose an option:")
        print("1. Search a value")
        print("2. Sort the array")
        print("3. Filter values")

        search_choice = int(input("Enter your choice: "))
        if search_choice == 1:

            value = int(input("\nEnter value to search: "))

            positions = np.argwhere(arr == value)

            print("\nOriginal Array:")
            print(arr)

            if len(positions) > 0:
                print(f"\nValue {value} found at positions:")
                print(positions)
            else:
                print(f"\nValue {value} not found.")
        elif search_choice == 2:

            sorted_arr = np.sort(arr)

            print("\nOriginal Array:")
            print(arr)

            print("\nSorted Array:")
            print(sorted_arr)

            print("(Sorting applied row-wise.)")
        elif search_choice == 3:

            threshold = int(input("\nShow values greater than: "))

            filtered = arr[arr > threshold]

            print("\nOriginal Array:")
            print(arr)

            print("\nFiltered Values:")
            print(filtered)

        else:
            print("Invalid choice!")
    if choice==5:
        print("\nStatistics Operations:")
        print("Choose an option:")
        print("1. Sum")
        print("2. Mean")
        print("3. Median")
        print("4. Standard Deviation")
        print("5. Variance")

        stats_choice = int(input("Enter your choice: "))
        if stats_choice == 1:

            result = np.sum(arr)

            print("\nArray:")
            print(arr)

            print("\nSum of all elements:")
            print(result)
        elif stats_choice == 2:

            result = np.mean(arr)

            print("\nArray:")
            print(arr)

            print("\nMean of all elements:")
            print(result)
        elif stats_choice == 3:

            result = np.median(arr)

            print("\nArray:")
            print(arr)

            print("\nMedian of all elements:")
            print(result)
        elif stats_choice == 4:

            result = np.std(arr)

            print("\nArray:")
            print(arr)

            print("\nStandard Deviation:")
            print(result)

        elif stats_choice == 5:

            result = np.var(arr)

            print("\nArray:")
            print(arr)

            print("\nVariance:")
            print(result)

        else:
            print("Invalid choice!")
    if choice==6:
        print("Thank you for using numpy analyzer")
        break
